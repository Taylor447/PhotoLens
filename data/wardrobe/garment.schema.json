{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Taylor447/PhotoLens/blob/main/data/wardrobe/garment.schema.json",
  "title": "PhotoLens procedural garment catalog (not retail-product data)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "realGarmentCount",
    "templates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "procedural-template"
    },
    "realGarmentCount": {
      "const": 0,
      "description": "Count of verified physical/retail garments in this file; current value is intentionally zero."
    },
    "templates": {
      "type": "array",
      "minItems": 60,
      "items": {
        "$ref": "#/$defs/garmentTemplate"
      }
    }
  },
  "$defs": {
    "measurementCm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300,
      "description": "A user-entered or sourced linear measurement in centimetres. The property name identifies its landmark and dimension."
    },
    "measurementsCm": {
      "oneOf": [
        {
          "$ref": "#/$defs/garmentMeasurementsCm"
        },
        {
          "type": "null"
        }
      ]
    },
    "assetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "generated-by-photolens",
            "licensed-third-party"
          ]
        }
      }
    },
    "sizeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "measurementsCm",
        "measurementSource"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "measurementsCm": {
          "$ref": "#/$defs/garmentMeasurementsCm"
        },
        "measurementSource": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "garmentTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "legacyCategory",
        "layer",
        "layerOrder",
        "styleTags",
        "season",
        "temperatureC",
        "weather",
        "materialId",
        "patternId",
        "fit",
        "recolorableRegions",
        "sizeTable",
        "measurementsCm",
        "measurementSource",
        "shootingNotes",
        "culturalNote",
        "assets",
        "sizeTableVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tpl-[a-z0-9-]+-[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "tops",
            "bottoms",
            "skirts",
            "dresses",
            "outerwear",
            "shoes",
            "hats",
            "bags",
            "eyewear",
            "scarves",
            "jewelry",
            "hair"
          ]
        },
        "legacyCategory": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "tops",
            "bottoms",
            "dresses",
            "outerwear",
            "shoes",
            "accessories",
            null
          ]
        },
        "layer": {
          "enum": [
            "base",
            "mid",
            "outer",
            "accessory"
          ]
        },
        "layerOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "styleTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "vintage",
              "streetwear",
              "office",
              "active",
              "traditional",
              "cosplay",
              "classic",
              "cinematic",
              "casual"
            ]
          }
        },
        "season": {
          "enum": [
            "all",
            "spring",
            "summer",
            "autumn",
            "winter"
          ]
        },
        "temperatureC": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -80,
              "maximum": 80
            },
            "max": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -80,
              "maximum": 80
            }
          }
        },
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rain",
            "wind"
          ],
          "properties": {
            "rain": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "wind": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "materialId": {
          "type": "string",
          "minLength": 1
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "enum": [
            "slim",
            "regular",
            "relaxed",
            "oversize",
            "layered"
          ]
        },
        "recolorableRegions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sizeTable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sizeRecord"
          }
        },
        "measurementsCm": {
          "$ref": "#/$defs/measurementsCm"
        },
        "measurementSource": {
          "type": [
            "string",
            "null"
          ]
        },
        "shootingNotes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "moireRisk",
            "reflective",
            "wrinkle",
            "highlight"
          ],
          "properties": {
            "moireRisk": {
              "type": "boolean"
            },
            "reflective": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "wrinkle": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "highlight": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "culturalNote": {
          "type": [
            "string",
            "null"
          ],
          "description": "Respectful cultural note where relevant; null when no verified note is available."
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "svg",
            "procedural3d",
            "glb",
            "thumbnail"
          ],
          "properties": {
            "svg": {
              "$ref": "#/$defs/assetReference"
            },
            "procedural3d": {
              "$ref": "#/$defs/assetReference"
            },
            "glb": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/assetReference"
                }
              ]
            },
            "thumbnail": {
              "$ref": "#/$defs/thumbnailReference"
            }
          }
        },
        "sizeTableVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Version identifier for the garment size table; null when no verified size table exists."
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "neck": {
              "enum": [
                "crew",
                "v",
                "square",
                "high"
              ]
            },
            "sleeve": {
              "enum": [
                "short",
                "long",
                "sleeveless",
                "wide"
              ]
            },
            "length": {
              "enum": [
                "short",
                "regular",
                "long"
              ]
            },
            "width": {
              "enum": [
                "slim",
                "regular",
                "wide"
              ]
            },
            "pleats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          }
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurementsCm": {
                "type": "object"
              }
            },
            "required": [
              "measurementsCm"
            ]
          },
          "then": {
            "properties": {
              "measurementSource": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sizeTable": {
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "sizeTable"
            ]
          },
          "then": {
            "properties": {
              "sizeTableVersion": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "garmentMeasurementsCm": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "shoulderWidthCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "chestCircumferenceCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "waistCircumferenceCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "hipCircumferenceCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "sleeveLengthCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "inseamLengthCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "neckCircumferenceCm": {
          "$ref": "#/$defs/measurementCm"
        },
        "garmentLengthCm": {
          "$ref": "#/$defs/measurementCm"
        }
      },
      "description": "Verified garment dimensions in centimetres; distinct from the mannequin body measurement record."
    },
    "thumbnailReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "generated-by-photolens",
            "licensed-third-party"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assets/wardrobe/previews/[a-z0-9-]+\\.svg$"
        }
      }
    }
  }
}
