{
  "name": "photolens",
  "private": true,
  "version": "1.1.0",
  "description": "Phân tích và so sánh ảnh bằng chỉ số cục bộ và Gemini AI",
  "author": "PhotoLens",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "npm run data:build && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "cap:android": "npm run build && cap sync android && npm run android:manifest && cap open android",
    "cap:sync": "npm run build && cap sync android && npm run android:manifest",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "worker:dev": "npx wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml",
    "android:manifest": "node scripts/ensure-android-manifest.mjs",
    "test:unit": "vitest run --configLoader runner && node --test tests/device-data.test.js",
    "test:worker": "node --test worker/src/index.test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test": "npm run test:unit && npm run test:worker && npm run test:e2e",
    "data:fetch": "node scripts/device-data.mjs fetch",
    "data:import": "node scripts/device-data.mjs import",
    "data:update": "node scripts/device-data.mjs update",
    "data:check": "node scripts/device-data.mjs check",
    "data:report": "node scripts/device-data.mjs report",
    "data:build": "node scripts/device-data.mjs build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/splash-screen": "^7.0.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wrangler": "^4.36.0",
    "vitest": "^5.1.0",
    "@playwright/test": "^1.65.1",
    "ajv": "^8.20.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.photolens.desktop",
    "productName": "PhotoLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}