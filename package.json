{
  "name": "photolens",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:android": "npm run build && node scripts/ensure-android.mjs && cap sync android && cap open android",
    "cap:sync": "npm run build && cap sync",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "worker:dev": "npx wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.toml",
    "test:unit": "node --test tests/core-planner.test.js tests/wardrobe-studio.test.js tests/worker-outfit.test.js tests/wardrobe-3d.test.js && node tools/assets/validate-wardrobe.mjs",
    "test": "npm run test:unit && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "ajv": "^8.20.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.photolens.desktop",
    "productName": "PhotoLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "core-js@3.51.0": true,
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}
